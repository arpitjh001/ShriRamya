{
  "name": "shriramya-qa-tests",
  "version": "1.0.0",
  "description": "QA Automation Tests for ShriRamya E-Commerce Platform",
  "scripts": {
    "test:api": "jest --config jest.api.config.js --runInBand",
    "test:api:auth": "jest --config jest.api.config.js tests/api/auth.test.js",
    "test:api:products": "jest --config jest.api.config.js tests/api/products.test.js",
    "test:api:cart": "jest --config jest.api.config.js tests/api/cart.test.js",
    "test:api:orders": "jest --config jest.api.config.js tests/api/orders.test.js",
    "test:api:filters": "jest --config jest.api.config.js tests/api/categoryFilters.test.js",
    "test:api:categories": "jest --config jest.api.config.js tests/api/categories.test.js",
    "test:api:blogs": "jest --config jest.api.config.js tests/api/blogs.test.js",
    "test:api:coverage": "jest --config jest.api.config.js --coverage",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:customer": "playwright test --config=tests/e2e/playwright.config.ts tests/e2e/customer-flow.spec.ts",
    "test:e2e:admin": "playwright test --config=tests/e2e/playwright.config.ts tests/e2e/admin-flow.spec.ts",
    "test:e2e:auth": "playwright test --config=tests/e2e/playwright.config.ts tests/e2e/auth-flow.spec.ts",
    "test:e2e:rbac": "playwright test --config=tests/e2e/playwright.config.ts tests/e2e/rbac.spec.ts",
    "test:e2e:ui": "playwright test --config=tests/e2e/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report tests/e2e/playwright-report",
    "test:all": "npm run test:api && npm run test:e2e",
    "test:ci": "CI=true npm run test:all"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.4.0",
    "jest-junit": "^17.0.0",
    "supertest": "^6.3.3"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
