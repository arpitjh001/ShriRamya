{
  "name": "shriramya-node-backend",
  "version": "2.0.0",
  "description": "Production-grade Node.js Express backend for ShriRamya Ecommerce Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --config jest.config.js --runInBand --forceExit",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:rbac": "jest --config jest.config.js --runInBand --forceExit tests/rbac.test.js",
    "test:tenant": "jest --config jest.config.js --runInBand --forceExit tests/tenant-isolation.test.js",
    "test:api": "jest --config jest.config.js --runInBand --forceExit tests/api.test.js",
    "test:validation": "jest --config jest.config.js --runInBand --forceExit tests/api-validation.test.js",
    "setup:test-db": "node tests/setup-test-db.js",
    "seed:users": "node scripts/seed-users.js",
    "seed:blogs": "node scripts/seed-blogs.js",
    "seed:admin": "node scripts/seed-admin-user.js",
    "seed:rbac": "node scripts/seed-rbac-roles.js",
    "migrate": "node scripts/run-migrations.js",
    "migrate:categories": "node scripts/migrate-categories.js",
    "migrate:data": "node scripts/migrate-data-to-tenant.js",
    "migrate:rollback": "node -e \"require('./src/utils/dbMigration').rollbackMigration()\"",
    "queue:process": "node -e \"const q = require('./src/services/queue/jobQueue.service'); q.setupQueueListeners(); console.log('Queue processor started');\"",
    "optimize:images": "node scripts/optimize-images.js",
    "docker:build": "docker build -f Dockerfile.production -t shriramya-backend:latest .",
    "docker:up": "docker-compose -f docker-compose.production.yml up -d",
    "docker:down": "docker-compose -f docker-compose.production.yml down"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "http-status": "^1.7.3",
    "ioredis": "^5.10.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.8",
    "razorpay": "^2.9.2",
    "sharp": "^0.33.2",
    "stripe": "^14.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}