PORT=8000
NODE_ENV=production
DB_NAME=shriramya
COOKIE_SECURE=true
CORS_ORIGINS=https://yourdomain.com
PUBLIC_BASE_URL=https://yourdomain.com
SMS_PROVIDER=twilio
SMS_SENDER_ID=YOURAPP
SMTP_PORT=587
SMTP_SECURE=false
SMTP_HOST=smtp.example.com

# Database Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp
MONGODB_NON_SRV_HOSTS=host1:27017,host2:27017,host3:27017
MONGODB_NON_SRV_OPTIONS=tls=true&authSource=admin&replicaSet=replica-set&retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Redis Configuration
REDIS_URL=redis://default:password@host:6379

# Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Shiprocket Delivery
SHIPROCKET_ENABLED=false
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=api-user@example.com
SHIPROCKET_PASSWORD=your-shiprocket-api-user-password
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=302001
SHIPROCKET_COMPANY_NAME=Shri Ramya
SHIPROCKET_RESELLER_NAME=Shri Ramya
SHIPROCKET_DEFAULT_PACKAGE_WEIGHT=0.5
SHIPROCKET_DEFAULT_PACKAGE_LENGTH=10
SHIPROCKET_DEFAULT_PACKAGE_BREADTH=10
SHIPROCKET_DEFAULT_PACKAGE_HEIGHT=10

# Email Configuration
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password

# Cron Jobs
CRON_SECRET=your-cron-secret-key

# Order Deletion
DELETE_ORDER_SECRET=Mjg0MDAx

